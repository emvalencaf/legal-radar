# Neo4j connection used by `legal-radar run` and docker-compose.yml
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=legal-radar-dev

# Model providers (see router.yaml); LM Studio needs no key
GROQ_API_KEY=
GEMINI_API_KEY=
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Optional: `make refresh-prompts` pulls from LangSmith and, when set, `ask` and `eval` trace the
# query-time LangGraph run and the evaluation there (LANGSMITH_TRACING=false opts out). Without
# it everything runs identically; the pipeline and tests read prompts/lock.json
LANGSMITH_API_KEY=

# SQLite file of the ingestion metadata (enrichment records); default data/ingestion.sqlite
# METADATA_DB=data/ingestion.sqlite
# Optional judge model for `legal-radar eval --grounding` (any OpenAI-compatible endpoint)
# RAGAS_BASE_URL=http://localhost:1234/v1
# RAGAS_MODEL=local-model
# RAGAS_API_KEY=
